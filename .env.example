# このファイルを .env にコピーして、トークンを書き換えてください
DISCORD_TOKEN=your_token_here
VOICEVOX_URL=http://127.0.0.1:50021

# --- 監視(任意) ---
# あなたのDiscordユーザーID(/status を使える人)。設定 → 詳細設定 → 開発者モード をオンにして、自分のアイコンを長押し →「IDをコピー」
OWNER_ID=
# 自分だけが見られるチャンネルのWebhook URL(起動・エンジン停止の通知用)
LOG_WEBHOOK_URL=
# healthchecks.io などの死活監視URL(PC自体が止まったときの通知用)
HEALTHCHECK_URL=
